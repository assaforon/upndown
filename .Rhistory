ktargOptions(0.8)
tools::buildVignettes(dir = '.',  tangle=TRUE)
library(upndown)
k2targ(2, lowTarget = TRUE)
k2targ(2, lowTarget = FALSE)
k2targ(3, lowTarget = FALSE)
ktargOptions(0.8)
bcoin(0.8)
gtargOptions(0.3)
M=10
# Example F(x) curve:
exp9F = pexp(1:M, rate=1/9)
plot(exp9F, type = 'l', xlab = 'Dose Level', ylim = c(0,1), las=1 )
abline(h=c(.3,.5),col=2,lty=3)
cmat = classicmat(exp9F)
round(cmat, 2)
bmat = bcdmat(exp9F, target = 0.3)
round(bmat, 2)
bcoin(.3)
library(lattice)
levelplot(cmat, xlab = 'x(t)', ylab = 'x(t+1)')
levelplot(bmat, xlab = 'x(t)', ylab = 'x(t+1)')
kmat0 = kmatFull(exp9F, k = 2, lowTarget = TRUE)
levelplot(kmat0, xlab = 'x(t)', ylab = 'x(t+1)')
kmat1 = kmatMarg(exp9F, k = 2, lowTarget = TRUE)
levelplot(kmat1, xlab = 'x(t)', ylab = 'x(t+1)')
levelplot(bmat, xlab = 'x(t)', ylab = 'x(t+1)')
levelplot(kmat1, xlab = 'x(t)', ylab = 'x(t+1)')
kmat1
round(kmat0,2)
exp9F
bpi = pivec(exp9F, matfun = bcdmat, target = 0.3)
bp1_20 = cumulvec(exp9F, matfun = bcdmat, target = 0.3, startdose = 1, n = 20)
bp20 = currentvec(exp9F, matfun = bcdmat, target = 0.3, startdose = 1, n = 20)
plot(bpi, type = 'l', main = 'BCD Allocation Example', xlab = 'Dose Level', ylab = 'Proportion of Allocations',  ylim = c(0,0.3), las=1, lwd = 2 )
lines(bp1_20, col = 4, lwd = 2)
lines(bp20, col = 2, lwd = 2)
legend('topright', legend = c('Stationary / Asymptotic', 'Cumulative,starting at d_1 (n=20)', 'Current Marginal, starting at d_1 (n=20)'), col = c(1,4,2), lwd = 2, bty = 'n')
library(upndown)
gtargOptions(.8)
xropi03 = c(11:9,10:8,9,10,9,10:7,8:11,10:12,11:7,8,7:10,9,8,9,8:10,9,10,9,10)
xlevo03 = c(11,10,11,10,11:9,10:7,8,7,8:5,6:8,7,8:6,7,6,7,6,7:5,6,7,6:12)
yropi03=(1-diff(xropi03))/2
ylevo03 = (1-diff(xlevo03))/2
length(xropi03)
armDiffCI(xropi03[-40], yropi03, xlevo03[-40], ylevo03, target = 0.5)
?armDiffCI
?drplot
doses = c(4:7, 6:13, 12:19, 18:21, 20, 19:23, 22, 21:23, 22:19, 20:23,
22:24, 23, 22, 23, 22:25, 24:22, rep(23:24,2), 23, 22)
# With U&D, responses (except the last one) can be read off the doses:
responses = c( (1 - sign(diff(doses)))/2, 0 )
drplot(doses, responses, main=' Dose-Response', percents = TRUE,
addest = TRUE, target = 0.5, addcurve = TRUE,
xtitle = 'Gabapentin (mg/kg)', ytitle = "Percent Effective")
